# 알뜰티켓 환경변수 — 이 파일을 .env 로 복사 후 실제 값 입력
SECRET_KEY=change-me-to-random-string

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ticket
DB_PASSWORD=change-me
DB_NAME=ticket_db

# TODO(대표 확인): 채널톡 플러그인 키 — 비우면 채널톡 부트 스크립트 미삽입, openChannel()은 fallback alert
CHANNELTALK_PLUGIN_KEY=

# 텔레그램 알림 봇 — 비우면 알림 전송 skip (로컬 개발 시 비워둬도 됨)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
